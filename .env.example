# ORBI ChatBox IA Core — Environment Example
# No colocar secretos reales en el repositorio.
# Copiar este archivo a .env para desarrollo local y completar SOLO en el .env local.

# Backend receiver
ORBI_SERVER_PORT=8787
ORBI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ORBI_DEMO_WIDGET_PUBLIC_KEY=orbi_demo_widget_key
ORBI_WIDGET_RATE_LIMIT_WINDOW_MS=60000
ORBI_WIDGET_RATE_LIMIT_MAX_REQUESTS=30
ORBI_AUDIT_LOG_ENABLED=true

# Optional AI provider development key
# GEMINI_API_KEY="your_optional_development_key"

# Optional app URL
# APP_URL="http://localhost:3000"

# WhatsApp Business Platform / Cloud API
# Safety defaults: transport disabled, outbound composition disabled, native sends locked.
WHATSAPP_ENABLED=false
WHATSAPP_OUTBOUND_DELIVERY_ENABLED=false
WHATSAPP_LIVE_SEND_ENABLED=false

# Webhook boundary
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Graph API outbound boundary
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=

# Live-test safety boundary
# Comma-separated E.164 digits only, without "+".
WHATSAPP_TEST_RECIPIENT_ALLOWLIST=

# Optional template test configuration
WHATSAPP_TEST_TEMPLATE_NAME=
WHATSAPP_TEST_TEMPLATE_LANGUAGE_CODE=

# IMPORTANT:
# - Nunca pegar tokens/secrets en commits, logs, screenshots o chats.
# - El archivo .env real está ignorado por Git.
# - WHATSAPP_OUTBOUND_DELIVERY_ENABLED y WHATSAPP_LIVE_SEND_ENABLED deben
#   permanecer false hasta una prueba live explícitamente autorizada.
