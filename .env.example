# ORBI ChatBox IA Core — Environment Example
# Estado actual: sandbox/demo avanzada.
# No colocar secretos reales en el repositorio.

# Futuro uso backend / IA:
# GEMINI_API_KEY="your_optional_development_key"

# Futuro uso app URL:
# APP_URL="http://localhost:3000"

# Producción externa, WhatsApp real y backend productivo siguen bloqueados hasta módulos posteriores.

# ORBI ChatBox IA Core — Backend Receiver Sandbox
ORBI_SERVER_PORT=8787
ORBI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ORBI_DEMO_WIDGET_PUBLIC_KEY=orbi_demo_widget_key
ORBI_WIDGET_RATE_LIMIT_WINDOW_MS=60000
ORBI_WIDGET_RATE_LIMIT_MAX_REQUESTS=30
ORBI_AUDIT_LOG_ENABLED=true

# No colocar secretos reales.
# Producción externa sigue bloqueada.
# WhatsApp real sigue bloqueado.
